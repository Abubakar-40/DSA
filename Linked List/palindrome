//LeetCode: https://leetcode.com/problems/palindrome-linked-list/

class Solution {
public:
    bool isPalindrome(ListNode* head) {
        vector<int> v;
        ListNode* temp = head;
        while (temp != nullptr) {
            v.push_back(temp->val);
            temp = temp->next;
        }
        for(int i = 0,j=v.size()-1;i<v.size(),j>=0;i++,j--)
        {
            if(v[i] != v[j]){
                return false;
            }
        }
        return true;

    }
};
